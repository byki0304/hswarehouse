# Local secrets for hswarehouse
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.

# Gemini API Key
GEMINI_API_KEY=

# OAuth 클라이언트 ID
OAUTH_CLIENT_ID=

# Google Drive 배포 ID
GOOGLE_DRIVE_DEPLOYMENT_ID=

# Google Drive 웹앱 URL
GOOGLE_DRIVE_WEBAPP_URL=

# Google Drive 라이브러리 URL
GOOGLE_DRIVE_LIBRARY_URL=

# Firebase web config (public client keys — optional here; also in firebase_options.dart)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
